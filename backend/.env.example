# Groq API key — get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for the interviewer.
# (The brief specified llama-3.3-70b-versatile, but Groq has retired it; openai/gpt-oss-120b is the closest current option.)
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated list of allowed frontend origins. Add your deployed frontend here, e.g.
# CORS_ORIGINS=http://localhost:3000,https://ai-interview-coach.vercel.app
CORS_ORIGINS=http://localhost:3000

# Regex for extra allowed origins (default allows every *.vercel.app deployment). Set empty to disable.
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
